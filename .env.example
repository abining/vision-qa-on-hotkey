# 服务器配置
PORT=8003
LOG_LEVEL=INFO
DATA_DIR=data
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# 支持图片输入的 OpenAI 兼容接口；填写基础 URL，不含 /chat/completions
API_KEY=
API_BASE_URL=https://api.330103.xyz/v1
API_MODEL=gemini-3.1-flash-lite
API_STYLE=chat_completions
API_TEMPERATURE=0.2
API_MAX_TOKENS=128
API_TOKEN_PARAMETER=max_tokens
API_REASONING_EFFORT=minimal
API_TIMEOUT=30
API_MAX_RETRIES=0
AI_PROMPT="阅读图片中的问题，直接给出答案。选择题只输出选项字母，多题按题号列出；其他题用一句中文回答，尽量不超过40字。不复述题目，不解释过程。"
IMAGE_MAX_SIDE=1280

# 截图区域配置
SCREENSHOT_LEFT=200
SCREENSHOT_TOP=200
SCREENSHOT_WIDTH=1200
SCREENSHOT_HEIGHT=800
